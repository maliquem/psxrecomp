pfx 1
# Downsample: Adaptive. 3D (the framework's mask3d) keeps the high resolution;
# 2D comes from the console-resolution picture, smoothed.
pass down
  shader downsample.glsl
  input u_src source
  lines 240
pass out
  shader downsample-adaptive.glsl
  input u_src source
  input u_down down
  input u_m mask3d
