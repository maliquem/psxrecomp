pfx 1
# Downsample: Box. The high-resolution picture averaged down to the console's
# 240 lines (width at the picture's aspect), then shown sharp or smooth (u_ds).
pass down
  shader downsample.glsl
  input u_src source
  lines 240
pass out
  shader downsample-box.glsl
  input u_down down
  uniform u_ds 0
