pfx 1
# Shadow map check (Phase 3D): see shadowmap.glsl. u_shadowdir 0 0 -1 puts the
# light at the camera: then every scenery pixel should be green.
pass show
  shader shadowmap.glsl
  input u_src source
  input u_d depth
  input u_sm shadow
  uniform u_view 0 0 0 0
  uniform u_proj 1024 240 8 0
  uniform u_shadowdir 0 0 -1 0
