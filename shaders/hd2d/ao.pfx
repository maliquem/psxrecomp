pfx 1
# Ambient occlusion: estimate at 480 lines from the PGXP
# depth, two edge-aware blur passes, then a depth-aware upsample that darkens
# the 3D scenery only (mask3d). Needs 3D Fix (PGXP depth).
# Live tuning (TCP post_uniform): u_ao "radius intensity bias power",
# u_aoview "1 0 0 0" shows the AO alone.
pass est
  shader ao.glsl
  input u_d depth
  lines 480
  format rgba16f
  filter nearest
  uniform u_ao 11 2.6 0.3 1.0
  uniform u_proj 1024 240 8 0
pass bh
  shader ao-blur.glsl
  input u_src previous
  lines 480
  format rgba16f
  filter nearest
  uniform u_dir 1 0 0 0
pass bv
  shader ao-blur.glsl
  input u_src previous
  lines 480
  format rgba16f
  filter nearest
  uniform u_dir 0 1 0 0
pass out
  shader ao-out.glsl
  input u_src source
  input u_ao previous
  input u_d depth
  input u_m mask3d
  uniform u_aoview 0 0 0 0
