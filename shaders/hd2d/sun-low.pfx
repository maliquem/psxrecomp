pfx 1
# Sun, Low shadow detail (see sun.pfx).
# Directional light (sun/moon) with cast shadows, Phase 3D prototype: faces
# toward the light get the sun tint, faces away and shadows the ambient tint.
# Needs 3D Fix (PGXP depth). Live tuning (TCP post_uniform): u_sun "azimuth
# elevation 0 0" (degrees, around the measured floor up), u_shadow "0 bias dark 0",
# u_suncol / u_amb "r g b 0", u_sunview "1 0 0 0" shows the lit term alone.
# Shadow detail: sun-low.pfx (480 lines, 2048 map), sun.pfx (Mid: 960 lines,
# 2048 map), sun-high.pfx (1.5x the picture, 4096 map: smooth edges).
pass nrm
  shader sun-up.glsl
  input u_d depth
  input u_n depth
  lines 16
  format rgba16f
  filter nearest
  uniform u_upstage 0 0 0 0
  uniform u_proj 1024 240 8 0
pass up
  shader sun-up.glsl
  input u_d depth
  input u_n previous
  lines 16
  format rgba16f
  filter nearest
  uniform u_upstage 1 0 0 0
  uniform u_proj 1024 240 8 0
pass est
  shader sun.glsl
  input u_d depth
  input u_up up
  input u_sm shadow
  input u_spr sprite
  input u_m mask3d
  # Low: 480 lines and no blur: crisp shadow edges (the sprites' pixel-art
  # silhouettes stay readable); the 3x3 shadow-map samples soften them enough
  lines 480
  format rgba16f
  filter nearest
  uniform u_sun 135 40 0 0
  uniform u_world 1 0 0 0
  uniform u_worldup 0 1 0 0
  uniform u_shadow 0 0.002 0.9 0
  uniform u_shadowdir 0 0 0 0
  uniform u_proj 1024 240 8 0
  uniform u_smsize 2048 0 0 0
pass out
  shader sun-out.glsl
  input u_src source
  input u_l previous
  input u_d depth
  input u_m mask3d
  input u_spr sprite
  uniform u_suncol 1.28 1.15 0.92 0
  uniform u_amb 0.5 0.56 0.74 0
  uniform u_sunview 0 0 0 0
