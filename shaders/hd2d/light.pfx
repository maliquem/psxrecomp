pfx 1
# Light from the game's own sources: what the
# framework marks as glowing (magic, fire, lamps) lights the 3D scenery near it
# in 3D, from the PGXP depth. Needs 3D Fix. Live tuning (TCP post_uniform):
# u_light "reach strength tint 0", u_lightview "1 0 0 0" shows the light alone.
pass emit
  shader light-emit.glsl
  input u_src source
  input u_m mask
  input u_d depth
  lines 60
  format rgba16f
pass bh
  shader light-blur.glsl
  input u_tex previous
  lines 60
  format rgba16f
  uniform u_dir 1 0
pass bv
  shader light-blur.glsl
  input u_tex previous
  lines 60
  format rgba16f
  uniform u_dir 0 1
pass gather
  shader light-gather.glsl
  input u_e previous
  input u_d depth
  lines 240
  format rgba16f
  uniform u_light 40 1.0 0.15 0
  uniform u_proj 1024 240 8 0
pass gh
  shader light-blur.glsl
  input u_tex previous
  lines 240
  format rgba16f
  uniform u_dir 1 0
pass gv
  shader light-blur.glsl
  input u_tex previous
  lines 240
  format rgba16f
  uniform u_dir 0 1
pass out
  shader light-out.glsl
  input u_src source
  input u_l previous
  input u_m3 mask3d
  uniform u_light 40 1.0 0.15 0
  uniform u_lightview 0 0 0 0
